# Copia questo file in .env alla radice del progetto e compila i valori
# (il file .env non viene mai committato su git)

# Dominio pubblico del sito (es. ivitrasporti.it)
DOMAIN=esempio.it

# Email per Let's Encrypt (rinnovi automatici)
CERTBOT_EMAIL=admin@esempio.it

# Genera con: openssl rand -hex 32
JWT_SECRET=cambiami-con-una-stringa-casuale

# Password amministratore iniziale (usata da script di bootstrap)
ADMIN_PASSWORD=cambiami-password-amministratore